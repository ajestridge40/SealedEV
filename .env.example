# Postgres connection (Neon / Supabase / local). Neon: use the pooled URL here and the direct URL below.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sealedev?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/sealedev?schema=public"

# Auth.js — generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET="replace-me"

# Comma-separated emails that get admin rights (add/edit products, odds, CSV import, manual refresh)
ADMIN_EMAILS="you@example.com"

# Protects /api/cron/refresh-prices. Vercel Cron sends "Authorization: Bearer $CRON_SECRET".
CRON_SECRET="replace-me-too"

# Optional price providers (all optional; the refresh job skips providers that are not configured)
POKEMONTCG_API_KEY=""
# Set to "1" to enable the TCGCSV (daily TCGplayer mirror) provider for sealed + card prices
ENABLE_TCGCSV="1"
# Set to "1" to enable Scryfall card prices for Magic
ENABLE_SCRYFALL="1"
